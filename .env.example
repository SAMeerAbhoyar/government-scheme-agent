# Environment Configuration Example
PROJECT_NAME="Automated Government Scheme Recommendation Agent"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration
POSTGRES_USER=scheme_user
POSTGRES_PASSWORD=scheme_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=scheme_db
DATABASE_URL="postgresql+asyncpg://scheme_user:scheme_password@localhost:5432/scheme_db"
DATABASE_URL_SYNC="postgresql+psycopg://scheme_user:scheme_password@localhost:5432/scheme_db"

# Authentication & Security
JWT_SECRET_KEY="super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Profile Column Encryption (32-char key for Fernet AES encryption of sensitive citizen data at rest)
ENCRYPTION_KEY="a3xR9Z5u1v8w2y4z7A6B8C0D2E4F6G8H"
PROFILE_ENCRYPTION_KEY="a3xR9Z5u1v8w2y4z7A6B8C0D2E4F6G8H"

# CORS Configuration (Comma separated list)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"

# Rate Limiting (Maximum requests per minute per IP for auth & discovery endpoints)
RATE_LIMIT_PER_MINUTE=60

# Maintenance & Health Settings
# Maximum consecutive crawl fetch failures before scheme is marked outdated
MAX_CONSECUTIVE_FETCH_FAILURES=3
# Flag to enable SMTP email notifications (disabled by default)
SEND_EMAIL_NOTIFICATIONS=False
# Flag to enable daily background APScheduler cron job for scheme ingestion
ENABLE_INGESTION_SCHEDULER=False

# AI / Vector Search Configuration (Phase 2/3 Placeholders)
EMBEDDING_DIMENSION=768
EMBEDDING_MODEL="text-embedding-004"
LLM_PROVIDER="gemini"
LLM_API_KEY="your-llm-api-key-placeholder"

# Frontend Configuration
# Base API URL used by the frontend client
VITE_API_BASE_URL="http://localhost:8000"
